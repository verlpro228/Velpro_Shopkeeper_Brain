# ====================
# MinerU (PDF 转 Markdown)
# ====================
# 模型来源（modelscope / huggingface）
MINERU_MODEL_SOURCE=modelscope
# 离线模式
MODELSCOPE_OFFLINE=1
# 模型缓存路径
MODELSCOPE_CACHE=./models/modelscope_cache
HF_HOME=./models/huggingface_cache
# 临时文件根目录
MD_ROOT_DIR=./temp-files/
# MinerU API Token（官网 https://mineru.net 申请）
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4

# ====================
# 大模型 (OpenAI 兼容 / 阿里云百炼 DashScope)
# ====================
# API 密钥（必填）
DASHSCOPE_API_KEY=
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen3.7-flash
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=deepseek-v4.1-flash
ITEM_MODEL=qwen3.7-flash
KG_MODEL=qwen3.7-flash

# ====================
# BGE Embedding / Reranker（本地推理）
# ====================
BGE_M3_PATH=
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cuda:0
BGE_FP16=1
BGE_RERANKER_LARGE=
BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_FP16=1
ITEM_NAME_DIAG=1
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Milvus 向量库
# ====================
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks_v1
ITEM_NAME_COLLECTION=kb_item_names_v1
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75
#MILVUS_USER=root
#MILVUS_PASSWORD=

# ====================
# MongoDB 对话历史
# ====================
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=kb001

# ====================
# MinIO 对象存储
# ====================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=knowledge-base-files

# ====================
# MCP 联网搜索
# ====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ====================
# 后端登录认证
# ====================
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_TOKEN_SECRET=
AUTH_EXPIRES_SECONDS=604800
